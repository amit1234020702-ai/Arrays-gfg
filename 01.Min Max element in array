//Minmum

Input: [5, 2, 8, 1, 9]
Output: 1
T:o(n)
S:o(1) 

class Solution {
    public int findMin(int[] arr) {  
        int min = arr[0];
        for (int i = 1; i < arr.length; i++) {
            if (arr[i] < min) {
                min = arr[i];
            }
        }
        return min;
    }
}

///////////////////////////////////////////////

Maximum
Input: [5, 2, 8, 1, 9]
Output: 9

T:o(n)
S:o(1)

class Solution {
    public int findMax(int[] arr) {
        int max = arr[0];
        for (int i = 1; i < arr.length; i++) {
            if (arr[i] > max) {
                max = arr[i];
            }
        }
        return max;
    }
}

