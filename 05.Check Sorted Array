Input: arr[] = [10, 20, 30, 40, 50]
Output: true
s:O(n^2)

class Solution {
    public boolean isSorted(int[] arr) {
        int n=arr.length;
        for(int i=0;i<n;i++){
            for(int j=i+1;j<n;j++){
                if(arr[i]>arr[j]){
                 return false;
                }
            }
        }  
        return true;
    }
}

