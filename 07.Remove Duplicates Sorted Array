26. Remove Duplicates from Sorted Array
Input: nums = [1,1,2]
Output: 2, nums = [1,2,_]
yt=https://www.youtube.com/watch?v=rlqssRvFSZs
class Solution {
    public int removeDuplicates(int[] nums) {
        int i=1;
        for(int j=1;j<nums.length;j++){
            if(nums[j-1] !=nums[j]){ 
                nums[i]=nums[j];
                i++;
            }
        }
        return i;
        
    }
}
