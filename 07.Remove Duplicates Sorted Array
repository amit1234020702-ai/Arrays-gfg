        int k=1;
        for(int j=1;j<nums.length;j++){
            if(nums[j]!=nums[j-1]){
                nums[k]=nums[j];
                k=k+1;
            }
        }
        ArrayList<Integer> ans=new ArrayList<>();
        for(int i=0;i<k;i++){
            ans.add(nums[i]);
        }
        return ans;
    }
}
