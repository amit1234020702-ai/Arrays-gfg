class Solution {
    void pushZerosToEnd(int[] arr) {
        int i=0;
        int j=0;
        while(i<arr.length){
            if(arr[i]==0){
                i++;
            }else{
                int temp=arr[i];
                arr[i]=arr[j];
                arr[j]=temp;
                i++;
                j++;
            }
        }
        
        
    }
