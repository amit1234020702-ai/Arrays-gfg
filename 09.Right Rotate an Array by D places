Rotate Array by One
Input: arr[] = [1, 2, 3, 4, 5]
Output: [5, 1, 2, 3, 4]

Input: arr[] = [9, 8, 7, 6, 4, 2, 1, 3]
Output: [3, 9, 8, 7, 6, 4, 2, 1]


class Solution {
    public void rotate(int[] arr) {
        int n=arr.length;
        int last=arr[n-1];
        for(int i=n-1;i>0;i--){
            arr[i]=arr[i-1];
        }
        arr[0]=last;
        
    }
}

