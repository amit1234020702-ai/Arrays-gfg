arr = [1, 2, 3, 4, 5]
d = 2
[4, 5, 1, 2, 3]
Time = O(n)
Space = O(1)
hint
1>full reverse
2>first d reverse
3>remaining reverse
class Solution {

    public void reverse(int[] arr, int start, int end) {

        while (start < end) {
            int temp = arr[start];
            arr[start] = arr[end];
            arr[end] = temp;

            start++;
            end--;
        }
    }

    public void rightRotate(int[] arr, int d) {

        int n = arr.length;
        d = d % n;

        reverse(arr, 0, n - 1);
        reverse(arr, 0, d - 1);
        reverse(arr, d, n - 1);
    }
} 

///Left Rotate by D places
Time = O(n)
Space = O(1)
arr = [1, 2, 3, 4, 5]
d = 2
[3, 4, 5, 1, 2]
//hint
1>frist reverse
2>reamining reverse
3>full reverse

class Solution {

    public void reverse(int[] arr, int start, int end) {

        while (start < end) {
            int temp = arr[start];
            arr[start] = arr[end];
            arr[end] = temp;

            start++;
            end--;
        }
    }

    public void leftRotate(int[] arr, int d) {

        int n = arr.length;
        d = d % n;

        reverse(arr, 0, d - 1);
        reverse(arr, d, n - 1);
        reverse(arr, 0, n - 1);
    }
}
