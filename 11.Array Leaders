[ 17 5 2]
  
class Solution {
    static ArrayList<Integer> leaders(int arr[]) {
        int n=arr.length;
        ArrayList<Integer> res=new ArrayList<>();
        int currLeader=arr[n-1];
        res.add(currLeader);
        for(int i=n-2;i>=0;--i){
            if(arr[i]>=currLeader){
                currLeader=arr[i];
                res.add(currLeader);
            }
        }
        Collections.reverse(res);
        return res;
        
    }
}
