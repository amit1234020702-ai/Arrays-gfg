 

class Main {
    public static void main(String[] args) {
       int []arr={10,20,30,40,50};
       int indexpos=1;  
       int[] newArray=new int[arr.length-1];
       int j=0;
       for(int i=0;i<arr.length;i++){
        if(i==indexpos){
            continue;
        }
        newArray[j]=arr[i];
        j++;
       }
       for(int num:newArray){
        System.out.print(num+" ");
       }
    }
}
