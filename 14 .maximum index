//O(n^2)
class Solution {
    int maxIndexDiff(int[] arr) {
        int N=arr.length; 
        int maxIndex=0;
        for(int i=0;i<N;i++){
            for(int j=N-1;j>i;j--){
                if(arr[i]<=arr[j]){
                    int temp=j-i;
                    maxIndex=Math.max(temp,maxIndex);
                }
            
            }
        
        }
        return maxIndex;
    }
}
