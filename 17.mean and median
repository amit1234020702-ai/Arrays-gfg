import java.util.Arrays;
class Main {

    public static void main(String[] args) {
  
        int[] arr = {1, 2, 3, 4, 5};
        // Mean
        int sum = 0;

        for (int i = 0; i < arr.length; i++) {
            sum += arr[i];
        }

        int mean = sum / arr.length;

        // Median
        Arrays.sort(arr);

        int n = arr.length;
        int median;

        if (n % 2 != 0) {
            median = arr[n / 2];
        } else {
            median = (arr[n / 2 - 1] + arr[n / 2]) / 2;
        }

        System.out.println("Mean = " + mean);
        System.out.println("Median = " + median);
    }
}
