class Solution {
    int typeOfArr(int arr[]) {
        int n=arr.length;
        int count=0; 
        for(int i=0;i<n-1;i++){
            if(arr[i]>arr[i+1]){
                count++;
            }
        }
        if(count==0){
            return 1;
        }
        if(count==1){
            return 4;
        }
        count=0;
        for(int i=0;i<n-1;i++){
            if(arr[i]<arr[i+1]){
                count++;
            }
        }
            if(count==0){
                return 2;
            }
            return 3;
        
    }
}
