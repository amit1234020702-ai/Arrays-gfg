class Solution { // yt link=https://www.youtube.com/watch?v=bbeUSdsLVsA
    public void reverseInGroups(int[] arr, int k) {
        int n=arr.length;
        for(int i=0;i<n;i=i+k){
            int left=i;                     0 1 2 3 4
            int right=Math.min(i+k-1,n-1);  1 2 3 4 5
            while(left<right){              l 
                int temp=arr[left];             r
                arr[left]=arr[right];      l<r
                arr[right]=temp;           3 2 1 5 4 
                left++; 
                right--;
            }
        }
    }
}
Input: arr[] = [1, 2, 3, 4, 5], k = 3
Output: [3, 2, 1, 5, 4]
