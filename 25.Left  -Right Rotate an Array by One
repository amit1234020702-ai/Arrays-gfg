//Right Rotate an Array by One
[1, 2, 3, 4, 5]->[5, 1, 2, 3, 4]class Solution {
    public void rightRotate(int[] arr) {
        
        int n = arr.length;
        
        int last = arr[n - 1];
        
        for(int i = n - 1; i > 0; i--) {
            arr[i] = arr[i - 1];
        }
        
        arr[0] = last;
    }
}

