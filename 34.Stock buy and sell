Input: arr[] = [4, 2, 2, 2, 4]
Output: 2

Input: arr[] = [4, 2]
Output: 0

Time Complexity  = O(n)
Space Complexity = O(1)

class Solution {
    int stockBuySell(int arr[]) {
        // code here
        int n=arr.length;
        int profit=0;
        for(int i=1;i<n;i++){
        if(arr[i]>arr[i-1]){
        profit+=(arr[i]-arr[i-1]);
        }
        }
        return profit;
    }
}
