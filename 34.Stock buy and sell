qsn====121. Best Time to Buy and Sell Stock
[7, 1, 5, 3, 6, 4]
6 - 1 = 5
Time Complexity: O(n)
Space Complexity: O(1)

minPrice = ab tak ka minimum/cheapest price
profit   = current price - minPrice
maxProfit = ab tak ka maximum profit


class Solution {
    public int maxProfit(int[] prices) {

        int minPrice = prices[0];
        int maxProfit = 0;

        for(int i = 1; i < prices.length; i++) {

            if(prices[i] < minPrice) {
                minPrice = prices[i];
            }

            int profit = prices[i] - minPrice;

            if(profit > maxProfit) {
                maxProfit = profit;
            }
        }

        return maxProfit;
    }
}

