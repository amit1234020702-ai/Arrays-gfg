Input: arr[] = [1, 2, 2, 3, 2] 
Output: 1 

Input: arr[] = [10, 20, 30, 40, 25, 50]
Output: 3

Time: O(n)
Space: O(1)

class Solution {
    public int maxStep(int[] arr) {
        int count = 0; 
        int max = 0;

        for (int i = 1; i < arr.length; i++) {
            if (arr[i] > arr[i - 1]) {
                count++;
                max = Math.max(max, count);
            } else {
                count = 0;
            }
        }

        return max;
    }
}
