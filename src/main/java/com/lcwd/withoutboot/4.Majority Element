Time: O(n)
Space: O(1)
class Solution {
    public int majorityElement(int[] nums) { yt=https://www.youtube.com/watch?v=l65QqDWD6xk
         int candidate = 0;
        int count = 0;

        for (int i : nums) {

            if (count == 0) {
                candidate = i;
            }

            if (i == candidate) {
                count++;
            } else {
                count--;
            }
        }

        return candidate;
    }
}
